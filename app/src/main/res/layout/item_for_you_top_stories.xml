<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingRight="2dp"
    android:paddingLeft="2dp"
    android:id="@+id/for_you_top_stories_click_layout">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:id="@+id/item_top_stories_layout">
        <com.mikhaellopez.circularprogressbar.CircularProgressBar
            android:id="@+id/circularProgressBar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            app:cpb_background_progressbar_color="@color/toolbar_boarder"
            android:layout_centerInParent="true"
            app:cpb_background_progressbar_width="8dp"
            android:visibility="gone"
            app:cpb_progress_direction="to_right"
            app:cpb_progressbar_color="#FFC823"
            app:cpb_progressbar_width="5dp"
            app:cpb_round_border="false" />
        <TextView
            android:id="@+id/for_you_top_stories_title_short"
            android:layout_width="@dimen/margin_75dp"
            android:layout_height="@dimen/margin_75dp"
            android:layout_centerInParent="true"
            android:background="@drawable/circle"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textSize="30sp"
            android:text="U" />
    </RelativeLayout>


    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
        android:textColor="@color/defaultcolor"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/for_you_top_stories_title"
        android:layout_below="@+id/item_top_stories_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="45dp"
        android:textSize="@dimen/text_size_20sp"
        android:text="SBI"
        android:singleLine="true"
        app:fontFamily="@font/quicksand_bold"/>

    <RelativeLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:id="@+id/for_you_top_stories_arrow_layout"
        android:visibility="gone"
        android:layout_below="@+id/for_you_top_stories_title"
        android:layout_marginTop="-10dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_arrow_drop_down"/>
    </RelativeLayout>




</RelativeLayout>