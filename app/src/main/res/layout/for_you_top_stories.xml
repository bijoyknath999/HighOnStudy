<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/for_you_top_stories_layout"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:text="@string/top_stories"
            android:textStyle="bold"
            android:textColor="@color/defaultcolor"
            android:textSize="20sp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"/>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/for_you_top_stories_pager"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/margin__20dp"
            android:layout_marginBottom="@dimen/margin__10dp"
            android:layout_below="@+id/txt_featured"
            android:layout_height="170dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

    </LinearLayout>

</RelativeLayout>